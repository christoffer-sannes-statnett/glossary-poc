@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix elhub: <https://glossary.elhub.no/concept/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

elhub:EAP a skos:Concept ;
    skos:broader elhub:EAV ;
    skos:definition "English description of EAP"@en,
        "Norsk beskrivelse for EAP"@no ;
    skos:inScheme <https://glossary.elhub.no/scheme/business-glossary> ;
    skos:notation "EAP" ;
    skos:prefLabel "Estimated annual production"@en,
        "Estimert årlig produksjon"@nn,
        "Estimert årlig produksjon"@no ;
    adms:status "active" .

elhub:GRID_OWNER a skos:Concept ;
    skos:definition "En aktørtype som innehas av et nettselskap. En netteier er ansvarlig for deler av strukturdata og grunndata, og registrering av måleverdier, i ett eller flere nettområder."@no ;
    skos:inScheme <https://glossary.elhub.no/scheme/business-glossary> ;
    skos:notation "GRID_OWNER" ;
    skos:prefLabel "Grid Owner"@en,
        "Netteier"@nn,
        "Netteier"@no ;
    adms:status "active" .

elhub:HYDRO a skos:Concept ;
    skos:broader elhub:PROD_GROUP ;
    skos:definition "Unit in which water energy is converted to electricity with unspecified equipment/devices."@en,
        "En enhet som konverterer vannkraft til elektrisitet med uspesifisert utstyr/metode"@no ;
    skos:inScheme <https://glossary.elhub.no/scheme/business-glossary> ;
    skos:notation "HYDRO" ;
    skos:prefLabel "Hydro"@en,
        "Vass"@nn,
        "Vann"@no ;
    adms:status "active" .

elhub:IMBALANCE_SETTLEMENT a skos:Concept ;
    skos:definition "Balanseavregningen gjøres ikke i Elhub men i eSett, og er avregningen av ubalanser i forhold til anmelding av kraft. Dette gjøres basert på Balanseavregningsgrunnlag som regnes ut i Elhub."@no ;
    skos:inScheme <https://glossary.elhub.no/scheme/business-glossary> ;
    skos:notation "IMBALANCE_SETTLEMENT" ;
    skos:prefLabel "Imbalance Settlement"@en,
        "Balanseavregning"@nn,
        "Balanseavregning"@no ;
    adms:status "active" .

elhub:INSTALLED_CAPACITY a skos:Concept ;
    skos:definition "Beskriver hvor mye energi som maksimalt kan produseres på et produksjonsanlegg. Verdien gjelder hva som maksimalt kan produseres i anlegget, ikke hva som maksimalt kan leveres ut på nettet. I Elhub er verdien gitt i kW."@no ;
    skos:inScheme <https://glossary.elhub.no/scheme/business-glossary> ;
    skos:notation "INSTALLED_CAPACITY" ;
    skos:prefLabel "Installed Capacity"@en,
        "Installert effekt"@nn,
        "Installert effekt"@no ;
    adms:status "active" .

elhub:INTERVAL_VALUE a skos:Concept ;
    skos:definition "Common term for intervals"@en,
        "Fellesbetegnelsen for Intervallstand og Intervallvolum."@no ;
    skos:inScheme <https://glossary.elhub.no/scheme/business-glossary> ;
    skos:notation "INTERVAL_VALUE" ;
    skos:prefLabel "Interval Value"@en,
        "Intervallverdi"@nn,
        "Intervallverdi"@no ;
    adms:status "active" .

elhub:METERING_VALUE a skos:Concept ;
    skos:definition "En Intervallverdi eller Målerstand. Kan være en målt eller estimert verdi. Fellesbetegnelse på alle verdier som representerer et forbruk eller produksjon på et Målepunkt eller på et aggregert nivå."@no ;
    skos:inScheme <https://glossary.elhub.no/scheme/business-glossary> ;
    skos:notation "METERING_VALUE" ;
    skos:prefLabel "Metering Value"@en,
        "Måleverdi"@nn,
        "Måleverdi"@no ;
    adms:status "active" .

elhub:MP a skos:Concept ;
    skos:definition "Et punkt der energiprodukter måles. Kan være av type produksjon, forbruk, kombinert eller utveksling. Målepunkt kan også være virtuelle eller tekniske målepunkt."@no ;
    skos:inScheme <https://glossary.elhub.no/scheme/business-glossary> ;
    skos:notation "MP" ;
    skos:prefLabel "Metering Point"@en,
        "Målepunkt"@nn,
        "Målepunkt"@no ;
    adms:status "active" .

elhub:QUALITY_CODE a skos:Concept ;
    skos:definition "En statuskode som kan settes på en måleverdi. Gyldige koder er: 21 Midlertidig, 46 Ingen verdi, 56 Estimert, 58 Tilbaketrukket, 81 Endelig estimert, 127 Målt."@no ;
    skos:inScheme <https://glossary.elhub.no/scheme/business-glossary> ;
    skos:notation "QUALITY_CODE" ;
    skos:prefLabel "Quality Code"@en,
        "Kvalitet"@nn,
        "Kvalitet"@no ;
    adms:status "active" .

elhub:RECON a skos:Concept ;
    skos:definition "Oppgjør mellom aktørene for alle endringer som blir registrert etter grunnlaget for balanseavregningen er låst (D+5). Det er Elhub som regner ut og fakturerer dette oppgjøret."@no ;
    skos:inScheme <https://glossary.elhub.no/scheme/business-glossary> ;
    skos:notation "RECON" ;
    skos:prefLabel "Reconciliation"@en,
        "Avviksoppgjør"@nn,
        "Avviksoppgjør"@no ;
    adms:status "active" .

elhub:SETTLEMENT_TYPE a skos:Concept ;
    skos:inScheme <https://glossary.elhub.no/scheme/business-glossary> ;
    skos:notation "SETTLEMENT_TYPE" ;
    skos:prefLabel "Settlement Type"@en,
        "Avregningsform"@nn,
        "Avregningsform"@no ;
    adms:status "active" .

elhub:SOLAR a skos:Concept ;
    skos:broader elhub:PROD_GROUP ;
    skos:definition "Unit in which solar energy is converted to electricity with unspecified equipment/devices"@en,
        "En enhet som konverterer solenergi til elektrisitet med uspesifisert utstyr/metode"@no ;
    skos:inScheme <https://glossary.elhub.no/scheme/business-glossary> ;
    skos:notation "SOLAR" ;
    skos:prefLabel "Solar"@en,
        "Sol"@nn,
        "Sol"@no ;
    adms:status "active" .

elhub:EAV a skos:Concept ;
    skos:definition "Collective term for estimated annual consumption and -production"@en,
        "Samlebetegnelse for estimert årlig forbruk og -produksjon"@no ;
    skos:inScheme <https://glossary.elhub.no/scheme/business-glossary> ;
    skos:notation "EAV" ;
    skos:prefLabel "Estimated annual volume"@en,
        "Estimert årlig volum"@nn,
        "Estimert årlig volum"@no ;
    adms:status "active" .

elhub:PROD_GROUP a skos:Concept ;
    skos:definition "The group a production unit belongs to"@en,
        "Hvilken overordnet gruppe en produksjonsenhet tilhører"@no ;
    skos:inScheme <https://glossary.elhub.no/scheme/business-glossary> ;
    skos:notation "PROD_GROUP" ;
    skos:prefLabel "Production Group"@en,
        "Produksjonsgruppe"@nn,
        "Produksjonsgruppe"@no ;
    adms:status "active" .

<https://glossary.elhub.no/scheme/business-glossary> a skos:ConceptScheme ;
    skos:prefLabel "Elhub Business Glossary"@en,
        "Elhub forretningsordliste"@no .

