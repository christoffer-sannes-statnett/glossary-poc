@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix elhub: <https://glossary.elhub.no/concept/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

elhub:EAV a skos:Concept ;
    skos:notation "EAV" ;
    skos:prefLabel "Estimated annual volume"@en,
        "Estimert årlig volum"@no,
        "Estimert årlig volum"@nn ;
    skos:definition "Collective term for estimated annual consumption and -production"@en,
        "Samlebetegnelse for estimert årlig forbruk og -produksjon"@no ;
    skos:inScheme <https://glossary.elhub.no/scheme/business-glossary> ;
    adms:status "active" .
